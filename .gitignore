# Allowlist: only the zips, README and shared settings are published.
# Any other script, note, log or check added here stays on the PC.
/*
!/.gitignore
!/README.md
!/*.zip
!/Linux/
/Linux/*
!/Linux/*.zip
!/Windows/
/Windows/*
!/Windows/*.zip
!/source/
/source/*
!/source/*.zip
!/Updated Settings Files/

# kept on the PC, not in the repo
_to_delete/
Unused/
# leftovers from copying big files over in pieces
*.zip.[0-9][0-9][0-9]
*.joining
# the repo's .git copied over in pieces (setup)
PackagesGit.zip
update-settings.sh
# kept on the PC only: the packaging scripts and the notes for Claude Code
build-packages.py
CLAUDE.md
# the app signing key and its passwords: never published
*.keystore
*.jks
melktank-release.properties
# the Android build tools for the phone app (MelkTankRemote/android/build-apk.sh)
android-sdk/
*.building
